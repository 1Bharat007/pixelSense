{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "PixelSense",
  "version": "1.0.0",
  "identifier": "com.pixelsense.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "PixelSense",
        "width": 1024,
        "height": 680,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true
      }
    ],
    "trayIcon": {
      "id": "main-tray",
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false,
      "tooltip": "PixelSense — Adaptive Brightness"
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "PixelSense Contributors",
    "copyright": "Copyright © 2026 PixelSense Contributors",
    "shortDescription": "Intelligent adaptive display brightness for Windows",
    "longDescription": "PixelSense talks directly to your hardware via DDC/CI to adjust your monitor's actual backlight. By combining ambient light sensor data with real-time screen content analysis, it continuously enforces the optimal brightness for your eyes.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "headerImage": null,
        "sidebarImage": null
      },
      "wix": null
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
